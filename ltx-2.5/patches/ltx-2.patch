index 0000000..76c19de
--- /dev/null
+++ b/packages/ltx-core/src/ltx_core/text_encoders/gemma/int8_convrot.py
@@ -0,0 +1,70 @@
+"""Loader support for Comfy INT8 ConvRot checkpoints."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import safetensors
+import torch
+from comfy_kitchen.tensor import QuantizedTensor, TensorWiseINT8Layout
+
+from ltx_core.loader.primitives import StateDict
+from ltx_core.loader.sd_ops import SDOps
+from ltx_core.loader.sft_loader import SafetensorsModelStateDictLoader
+
+_MARKER_SUFFIX = ".comfy_quant"
+_WEIGHT_SUFFIX = ".weight"
+_SCALE_SUFFIX = ".weight_scale"
+
+
+def is_comfy_int8_convrot_checkpoint(path: str | Path) -> bool:
+    """Return whether *path* contains Comfy's INT8 tensorwise markers."""
+    checkpoint = Path(path)
+    if not checkpoint.is_file() or checkpoint.suffix != ".safetensors":
+        return False
+    with safetensors.safe_open(checkpoint, framework="pt") as handle:
+        return any(key.endswith(_MARKER_SUFFIX) for key in handle.keys())  # noqa: SIM118
+
+
+def _decode_marker(value: torch.Tensor) -> dict[str, object]:
+    return json.loads(value.detach().cpu().numpy().tobytes())
+
+
+class ComfyInt8ConvRotStateDictLoader(SafetensorsModelStateDictLoader):
+    """Wrap marked Gemma or transformer weights before model loading."""
+
+    def load(
+        self,
+        path: str | list[str],
+        sd_ops: SDOps | None = None,
+        device: torch.device | None = None,
+    ) -> StateDict:
+        loaded = super().load(path, sd_ops=sd_ops, device=device)
+        state = loaded.sd
+        marker_keys = [key for key in state if key.endswith(_MARKER_SUFFIX)]
+        for marker_key in marker_keys:
+            prefix = marker_key[: -len(_MARKER_SUFFIX)]
+            marker = _decode_marker(state.pop(marker_key))
+            if marker.get("format") != "int8_tensorwise":
+                raise ValueError(f"unsupported Comfy quantization marker at {marker_key!r}: {marker}")
+
+            weight_key = f"{prefix}{_WEIGHT_SUFFIX}"
+            scale_key = f"{prefix}{_SCALE_SUFFIX}"
+            try:
+                weight = state[weight_key]
+                scale = state.pop(scale_key)
+            except KeyError as error:
+                raise ValueError(f"incomplete Comfy INT8 layer at {prefix!r}") from error
+            if weight.dtype != torch.int8:
+                raise ValueError(f"Comfy INT8 weight {weight_key!r} has dtype {weight.dtype}")
+
+            params = TensorWiseINT8Layout.Params(
+                scale=scale,
+                orig_dtype=torch.bfloat16,
+                orig_shape=tuple(weight.shape),
+                convrot=bool(marker.get("convrot", False)),
+                convrot_groupsize=int(marker.get("convrot_groupsize", 256)),
+            )
+            state[weight_key] = QuantizedTensor(weight, "TensorWiseINT8Layout", params)
+        return StateDict(sd=state, device=loaded.device, size=loaded.size, dtype=loaded.dtype)
